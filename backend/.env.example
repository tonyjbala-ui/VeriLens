# Copy to .env and fill in ONE of these keys (never commit .env).

# Preferred for cheap/fast hosted models (default stack):
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Optional overrides (defaults shown):
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=google/gemini-2.0-flash-lite:free

# Or use OpenAI-compatible API instead:
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Server bind (defaults):
# HOST=127.0.0.1
# PORT=8787
